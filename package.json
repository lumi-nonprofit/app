{
  "name": "lumi-app",
  "private": true,
  "version": "0.1.0",
  "main": "expo-router/entry",
  "description": "Lumi — česká aplikace pro podporu duševní pohody: check-in emocí, klid, přehledy a pomoc v krizi.",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "jest",
    "test:watch": "jest --watchAll",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "lint:docs": "bash scripts/vale.sh",
    "lint:md": "markdownlint-cli2",
    "spell": "cspell --no-progress --gitignore \"**\"",
    "check:english": "node scripts/check-english-source.mjs",
    "check:agents": "bash scripts/check-agents-mirror.sh",
    "check:docs": "npm run format:check && npm run lint:md && npm run spell && npm run lint:docs && npm run check:english && npm run check:agents",
    "i18n:extract": "i18next-cli extract",
    "i18n:check": "i18next-cli extract --ci && i18next-cli status && node scripts/check-i18n.mjs",
    "check:all": "npm run typecheck && npm run lint && npm test && npm run i18n:check && npm run check:docs"
  },
  "dependencies": {
    "@expo-google-fonts/bricolage-grotesque": "^0.4.1",
    "@expo/metro-runtime": "~56.0.15",
    "@react-native-community/datetimepicker": "9.2.1",
    "@react-native-community/slider": "5.2.1",
    "@react-native-segmented-control/segmented-control": "^2.5.7",
    "@types/react": "~19.2.14",
    "drizzle-orm": "^0.45.4",
    "expo": "^56.0.11",
    "expo-asset": "~56.0.17",
    "expo-audio": "~56.0.12",
    "expo-constants": "~56.0.18",
    "expo-crypto": "~56.0.4",
    "expo-dev-client": "~56.0.20",
    "expo-document-picker": "~56.0.4",
    "expo-file-system": "~56.0.8",
    "expo-font": "~56.0.6",
    "expo-haptics": "~56.0.3",
    "expo-keep-awake": "~56.0.3",
    "expo-linking": "~56.0.14",
    "expo-localization": "56.0.6",
    "expo-notifications": "~56.0.17",
    "expo-print": "~56.0.4",
    "expo-router": "~56.2.10",
    "expo-secure-store": "~56.0.4",
    "expo-sharing": "~56.0.17",
    "expo-splash-screen": "~56.0.10",
    "expo-sqlite": "~56.0.5",
    "expo-status-bar": "~56.0.4",
    "expo-symbols": "~56.0.6",
    "expo-system-ui": "~56.0.5",
    "i18next": "26.5.2",
    "intl-pluralrules": "2.0.1",
    "lucide-react-native": "^1.59.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-i18next": "17.1.0",
    "react-native": "0.85.3",
    "react-native-gesture-handler": "~2.31.1",
    "react-native-nitro-modules": "^0.37.1",
    "react-native-reanimated": "^4.7.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.25.2",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.4",
    "react-native-worklets": "^0.13.0",
    "typescript": "~6.0.3"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.3",
    "@cspell/dict-cs-cz": "^3.0.10",
    "@testing-library/react": "^16.3.3",
    "@testing-library/react-native": "^14.1.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/jest": "^29.5.14",
    "@types/jest-axe": "^3.5.9",
    "axe-core": "^4.14.0",
    "babel-plugin-inline-import": "^3.0.0",
    "better-sqlite3": "^12.10.0",
    "cspell": "^10.4.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^8.57.1",
    "eslint-config-expo": "^56.0.4",
    "eslint-plugin-i18next": "^6.1.5",
    "eslint-plugin-react-native-a11y": "^3.5.1",
    "i18next-cli": "^1.77.0",
    "jest": "~29.7.0",
    "jest-axe": "^11.0.0",
    "jest-expo": "~56.0.5",
    "markdownlint-cli2": "^0.23.3",
    "nitrogen": "^0.37.1",
    "prettier": "^3.9.10"
  },
  "expo": {
    "autolinking": {
      "exclude": [
        "lumi-vault"
      ]
    }
  }
}
